rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Root access denied
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ============================================
    // FIREBASE-ASSISTED HELPERS
    // ============================================
    // Storage rules can read Firestore to verify roles/company membership.
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['master-admin', 'super_admin']
      );
    }

    function userDoc(uid) {
      return firestore.get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // True if the caller is the company-admin of the given company.
    function isCompanyAdminOf(companyId) {
      return isSignedIn()
        && userDoc(request.auth.uid).role in ['company-admin', 'company_admin']
        && userDoc(request.auth.uid).companyId == companyId;
    }

    // True if the caller belongs to the given company.
    function belongsToCompany(companyId) {
      return isSignedIn() && userDoc(request.auth.uid).companyId == companyId;
    }

    // Staff managers: master-admin, company-admin, executive, team-leader.
    // The app scopes which records they can open; storage stays role-coarse.
    function isStaffManager() {
      return isSignedIn()
        && userDoc(request.auth.uid).role in ['master-admin', 'super_admin', 'company-admin', 'company_admin', 'executive', 'team-leader'];
    }

    // User avatars - authenticated users can read, owner can write
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024 // 2MB limit
        && request.resource.contentType.matches('image/.*');
    }

    // Company logos - company admins of that company (or master admin) can write,
    // authenticated can read
    match /company-logos/{companyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isMasterAdmin() || isCompanyAdminOf(companyId)
        && request.resource.size < 5 * 1024 * 1024 // 5MB limit
        && request.resource.contentType.matches('image/.*');
    }

    // Employee documents - role-based access scoped to the company
    match /documents/{companyId}/{employeeId}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == employeeId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(companyId));
      allow write: if isSignedIn()
        && (request.auth.uid == employeeId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(companyId))
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Payslips - employees can view own, company admins/master admin can view all
    match /payslips/{companyId}/{userId}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(companyId));
      allow write: if isStaffManager() || isMasterAdmin() || isCompanyAdminOf(companyId);
    }

    // Check-in selfies - only the owner can upload to their own path; the
    // company admin/master admin may view for verification
    match /selfies/{companyId}/{userId}/{fileName} {
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // 5MB limit
        && request.resource.contentType.matches('image/.*');
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isMasterAdmin()
          || isCompanyAdminOf(companyId));
    }

    // Executive onboarding documents - owner, master-admin, the company-admin
    // of the executive's company, or staff managers (executive/team-leader) may upload.
    match /executives/{userId}/{fileName} {
      allow write: if isSignedIn()
        && (request.auth.uid == userId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(userDoc(userId).companyId))
        && request.resource.size < 5 * 1024 * 1024 // 5MB limit
        && request.resource.contentType.matches('(image/jpeg|image/png|application/pdf)');
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(userDoc(userId).companyId));
    }

    // Team-leader onboarding documents - same access model as executives.
    match /team-leaders/{userId}/{fileName} {
      allow write: if isSignedIn()
        && (request.auth.uid == userId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(userDoc(userId).companyId))
        && request.resource.size < 5 * 1024 * 1024 // 5MB limit
        && request.resource.contentType.matches('(image/jpeg|image/png|application/pdf)');
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || isStaffManager()
          || isMasterAdmin()
          || isCompanyAdminOf(userDoc(userId).companyId));
    }

    // Public files
    match /public/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
