{
  "expo": {
    "name": "HR MAX",
    "slug": "sofixs-hrm-mobile",
    "version": "1.4.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hrmax.app",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "HR MAX uses the camera to verify attendance with selfie check-ins.",
        "NSPhotoLibraryUsageDescription": "HR MAX needs photo library access to upload documents such as Aadhar, PAN, joining letter and offer letter.",
        "NSLocationWhenInUseUsageDescription": "HR MAX accesses your location to verify attendance at the office location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hrmax.app",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6A00",
          "image": "./assets/splash.png",
          "imageWidth": 1284,
          "resizeMode": "cover"
        }
      ],
      "expo-notifications",
      "expo-document-picker",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HR MAX to access your location to verify attendance at the office location."
        }
      ],
      "expo-build-properties",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e640ec9d-44a1-4b67-b618-cda2e8ca22d6"
      }
    },
    "owner": "sofixscompany"
  }
}
