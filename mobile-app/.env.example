# ============================================================
# HR MAX — AWS configuration (mobile app)
# Values come from `sam deploy` outputs (same as the web app).
# Expo reads EXPO_PUBLIC_* vars from this .env automatically.
# ============================================================

# AWS region where the stack was deployed
EXPO_PUBLIC_AWS_REGION=ap-southeast-2

# Cognito User Pool (Outputs: UserPoolId)
EXPO_PUBLIC_COGNITO_USER_POOL_ID=

# Cognito App Client (Outputs: UserPoolClientId)
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# API Gateway base URL (Outputs: ApiUrl) — no trailing slash
EXPO_PUBLIC_API_URL=

# CloudFront URL for direct file access (Outputs: CloudFrontUrl)
EXPO_PUBLIC_FILES_BUCKET_URL=
