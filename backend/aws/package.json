{
  "name": "@sofixs-hrm/backend-aws",
  "version": "1.0.0",
  "private": true,
  "description": "HR MAX backend on AWS — API Gateway + Lambda + DynamoDB + Cognito + SES + S3",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "deploy": "sam build && sam deploy --guided",
    "deploy:guided": "sam build && sam deploy --guided",
    "logs": "sam logs -n ApiFunction --stack-name hrmax-api --tail",
    "local": "sam local start-api"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "22"
  }
}
