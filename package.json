{
  "name": "sofixs-hrm",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "build:functions": "npm run build -w backend",
    "lint": "npm run lint -w frontend",
    "preview": "npm run preview -w frontend",
    "mobile": "cd mobile-app && npx expo start",
    "mobile:android": "cd mobile-app && npx expo start --android",
    "mobile:ios": "cd mobile-app && npx expo start --ios",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm run build -w backend && firebase deploy --only functions",
    "deploy:all": "npm run build && npm run build -w backend && firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^13.29.0"
  }
}
