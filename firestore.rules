rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return isAuthenticated() ? getUserData().role : null;
    }
    
    function getUserCompanyId() {
      return isAuthenticated() ? getUserData().companyId : null;
    }

    function isMatrixRole() {
      return isAuthenticated() &&
        (getUserRole() == 'team-leader' || getUserRole() == 'executive');
    }

    // Legacy default permission arrays written to team-leader / executive docs
    // before the permission-matrix editor existed. Users still carrying one of
    // these arrays keep full access until an admin saves a new matrix.
    function legacyTeamLeaderDefaults() {
      return ['employees.view','departments.view','attendance.view','attendance.edit',
              'attendance.manage','leave.view','leave.manage','payroll.view',
              'payroll.edit','payroll.manage','reports.view','company.view',
              'tasks.view','tasks.create','tasks.edit','emails.view'];
    }
    function legacyExecutiveDefaults() {
      return ['employees.view','employees.create','employees.edit','departments.view',
              'payroll.view','payroll.edit','payroll.manage','attendance.view',
              'leave.view','leave.apply','leave.manage','settings.view',
              'company.view','tasks.view','tasks.create','tasks.edit',
              'emails.view','emails.create','assets.view'];
    }
    function isLegacyRoleDefault() {
      let stored = getUserData().permissions;
      return isMatrixRole() &&
        ((stored != null && getUserRole() == 'team-leader' &&
          stored.size() == 16 && stored.hasAll(legacyTeamLeaderDefaults())) ||
         (stored != null && getUserRole() == 'executive' &&
          stored.size() == 19 && stored.hasAll(legacyExecutiveDefaults())));
    }

    // Full access for team-leader/executive: unset/empty matrix, explicit '*',
    // or one of the legacy role-default arrays. Once an admin saves a core-CRUD
    // matrix (permissionsConfigured), the stored keys bind exactly.
    function isFullAccessMatrix() {
      let stored = getUserData().permissions;
      let configured = getUserData().permissionsConfigured == true;
      return isMatrixRole() &&
        !configured &&
        (stored == null || stored.size() == 0 || stored.hasAny(['*']) || isLegacyRoleDefault());
    }

    // ── Core CRUD simplification ─────────────────────────────────────
    // Team Leaders manage Companies, Executives and Employees; Executives
    // manage Employees. Every core module grants the four standard CRUD
    // actions by default (role-guaranteed) unless an admin-saved matrix
    // (permissionsConfigured) pins the exact stored keys.
    function isCoreCrudKey(perm) {
      return perm == 'companies.view' || perm == 'companies.create' ||
             perm == 'companies.edit' || perm == 'companies.delete' ||
             perm == 'executives.view' || perm == 'executives.create' ||
             perm == 'executives.edit' || perm == 'executives.delete' ||
             perm == 'employees.view' || perm == 'employees.create' ||
             perm == 'employees.edit' || perm == 'employees.delete';
    }

    function isCoreCrudGranted(perm) {
      let role = getUserRole();
      let parts = perm.split('.');
      let isRoleCore = role == 'team-leader' ||
                       (role == 'executive' && parts.size() > 0 && parts[0] == 'employees');
      let stored = getUserData().permissions;
      let configured = getUserData().permissionsConfigured == true;
      return isCoreCrudKey(perm) && isRoleCore &&
        (configured
          ? (stored != null && stored.hasAny([perm]))
          : true);
    }

    // Map action verbs used by older rule statements to the standardised
    // 12-action vocabulary of the permission matrix editor.
    function legacyPermissionAlias(p) {
      let aliases = {
        'departments.add': 'departments.create',
        'user_invite': 'employees.create',
        'attendance.mark': 'attendance.create',
        'email_view': 'emails.view',
        'email_create': 'emails.create',
        'email_edit': 'emails.edit',
        'email_delete': 'emails.delete',
        'asset_create': 'assets.create',
        'payroll.payslip': 'payroll.download',
        'employees.import': 'employees.create',
        'employees.export': 'employees.export',
      };
      return aliases[p] != null ? aliases[p] : p;
    }

    function hasPermission(permission) {
      let perm = legacyPermissionAlias(permission);
      let parts = perm.split('.');
      let moduleName = parts.size() > 0 ? parts[0] : '';
      let snake = perm.replace('.', '_');
      let stored = getUserData().permissions;
      // Legacy snake_case mapping: 'attendance.view' -> 'attendance_view'
      return isAuthenticated() &&
        (isFullAccessMatrix() ||
         isCoreCrudGranted(perm) ||
         stored != null && (
           stored.hasAny([perm]) ||
           stored.hasAny([snake]) ||
           (moduleName != '' && stored.hasAny([moduleName + '.*'])) ||
           (moduleName != '' && stored.hasAny([moduleName + '.manage'])) ||
           (moduleName != '' && stored.hasAny([moduleName + '_manage']))
         ));
    }
    
    // Per-module data-visibility scope from the permission matrix. 'all' (the
    // default) keeps the user's full authorized portfolio for the module;
    // 'assigned' narrows them to the companies they directly belong to.
    function isFullScopeForModule(moduleKey) {
      return !(getUserData().permissionScopes != null &&
               getUserData().permissionScopes[moduleKey] != null &&
               getUserData().permissionScopes[moduleKey] == 'assigned');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'master-admin';
    }
    
    function isCompanyAdmin() {
      return isAuthenticated() && getUserRole() == 'company-admin';
    }
    
    function belongsToCompany(companyId) {
      return isAuthenticated() && getUserCompanyId() == companyId;
    }
    
    function isExecutive() {
      return isAuthenticated() && getUserRole() == 'executive';
    }
    
    // Executives operate across ALL companies (no assignedCompanyIds bound).
    // Company selection happens in the UI ("All Companies" filter); writes stay
    // gated by the permission matrix (hasPermission) at every call site.
    function isExecutiveForCompany(companyId) {
      return isAuthenticated() && getUserData().role == 'executive';
    }
    
    function isTeamLeader() {
      return isAuthenticated() && getUserRole() == 'team-leader';
    }

    function isReportingManager() {
      return isAuthenticated() && getUserRole() == 'reporting-manager';
    }
    
    function isTeamLeaderForCompany(companyId) {
      return isTeamLeader() && belongsToCompany(companyId);
    }
    
    /**
     * True if the calling team-leader is linked to (reports to / manages with)
     * the given executive user id.
     */
    function isTeamLeaderLinkedTo(execId) {
      return isTeamLeader() &&
        execId != null && execId != '' &&
        (getUserData().reportingExecutiveId == execId ||
         (getUserData().linkedExecutiveIds != null &&
          getUserData().linkedExecutiveIds.hasAny([execId])));
    }

    /**
     * Enhanced TL scope check: true if TL is mapped to a company via linked/reporting executives,
     * OR the company is assigned to a linked/reporting executive. This allows TLs to manage
     * companies across their assigned executives' portfolios without relying on the TL's own
     * companyId (which may simply be 'master-admin').
     */
    function isTeamLeaderScopedForCompany(companyId) {
      let comp = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return isTeamLeader() &&
        (belongsToCompany(companyId) ||
         (comp != null && comp.assignedExecutiveId != null &&
          isTeamLeaderLinkedTo(comp.assignedExecutiveId)));
    }

    // Team Leaders are commonly assigned to a company via the assignedCompanyIds
    // array on their own users doc (this is how the app resolves the missed-punch
    // teamLeader tier). Treat that as scoped to the company even when the TL's
    // companyId field differs, so rule-side checks match client-side resolution.
    function isTeamLeaderAssignedToCompany(companyId) {
      let assigned = getUserData().assignedCompanyIds;
      return isTeamLeader() &&
        assigned != null &&
        assigned.hasAny([companyId]);
    }

    // Scope-aware record visibility for a module's company-scoped documents.
    // Under 'all' the executive/team-leader portfolio rights apply; under
    // 'assigned' only the caller's own company is readable.
    function canScopeRecord(companyId, moduleKey) {
      return belongsToCompany(companyId) ||
        (isFullScopeForModule(moduleKey) &&
         (isExecutiveForCompany(companyId) ||
          isTeamLeaderForCompany(companyId) ||
          isTeamLeaderScopedForCompany(companyId)));
    }
    
  function canManageCompany(companyId) {
    return isSuperAdmin() || (isCompanyAdmin() && belongsToCompany(companyId));
  }

  // Scope-aware CRUD for executives/team-leaders. Executives always write
  // inside their assigned companies; team-leaders may write across their whole
  // linked-executive portfolio unless the module scope is 'assigned' (then
  // only their own company). All writes stay gated by the permission matrix.
  function canCrudScoped(companyId, permission) {
    let parts = permission.split('.');
    let moduleKey = parts.size() > 0 ? parts[0] : '';
    return (isExecutiveForCompany(companyId) ||
            (isTeamLeader() &&
             (isFullScopeForModule(moduleKey) || belongsToCompany(companyId)))) &&
      hasPermission(permission);
  }

  /**
     * Attendance management: master-admin, the company admin of that company,
     * an executive assigned to that company, or a team-leader in that company.
     */
    function canManageAttendance(companyId) {
      return isSuperAdmin() ||
        (isCompanyAdmin() && belongsToCompany(companyId)) ||
        ((isExecutiveForCompany(companyId) || isTeamLeaderForCompany(companyId) || isTeamLeaderScopedForCompany(companyId)) &&
         hasPermission('attendance.manage')) ||
        // Reporting Managers manage attendance for their team (app scopes to
        // direct reports inside this company).
        (isReportingManager() && belongsToCompany(companyId));
    }

    /**
     * Tier-routed missed-punch verification: the assigned approver at a given
     * tier may advance a rectification routed to them within their company
     * scope, even when their saved permission matrix omits attendance.manage.
     * Mirrors the leaveRequests update tier-routing so a company-admin /
     * executive / team-leader named in approverIds can approve without a
     * matrix that lists attendance.manage.
     */
    function canReviewMissedPunchRecord(companyId, rec) {
      let mp = rec.missedPunchRectification;
      return isAuthenticated() &&
        mp != null &&
        mp.requested == true &&
        mp.approverIds != null && (
          (isCompanyAdmin() && belongsToCompany(companyId) &&
           mp.approverIds.companyAdmin == request.auth.uid) ||
          (isExecutiveForCompany(companyId) &&
           mp.approverIds.executive == request.auth.uid) ||
          // Reporting Manager / HR acting within their own company (part of the
          // management chain) on a request routed to them or to the company admin.
          // Both roles are treated as the same tier (mirrors the app's RM-tier /
          // applicantRole resolution, where hr-manager maps to reporting-manager).
          ((getUserRole() == 'reporting-manager' || getUserRole() == 'hr-manager') &&
           belongsToCompany(companyId) &&
           (mp.approverIds.reportingManager == request.auth.uid ||
            mp.approverIds.companyAdmin == request.auth.uid)) ||
          // Team Leader assigned as the teamLeader-tier approver. `approverIds`
          // is re-stamped authoritatively server-side, so the role + stamp match
          // is sufficient (mirrors the executive branch) — this covers TLs wired
          // to an executive via the executive's own `assignedTeamLeaderIds`
          // without carrying linked/company metadata on their own users doc.
          (isTeamLeader() &&
           mp.approverIds.teamLeader == request.auth.uid) ||
          (isTeamLeaderScopedForCompany(companyId) &&
           mp.approverIds.teamLeader == request.auth.uid) ||
          // Team Leader linked to a company via assignedCompanyIds (mirrors the
          // app's teamLeader-tier resolution).
          (isTeamLeaderAssignedToCompany(companyId) &&
           mp.approverIds.teamLeader == request.auth.uid) ||
          // Team Leader acting for their linked executive's tier (contingency).
          (isTeamLeaderScopedForCompany(companyId) &&
           mp.approverIds.executive != null &&
           isTeamLeaderLinkedTo(mp.approverIds.executive))
        );
    }
    
    // ============================================
    // COMPANIES COLLECTION
    // ============================================
    // Company documents include sensitive data (e.g. SMTP credentials under
    // settings.smtp). Only members of the company and management roles assigned
    // to it may read them; regular employees cannot list other companies.
    match /companies/{companyId} {
      function canReadCompany() {
        return isSuperAdmin() ||
          isExecutiveForCompany(companyId) ||
          (isTeamLeader() && isFullScopeForModule('companies')) ||
          isTeamLeaderScopedForCompany(companyId) ||
          belongsToCompany(companyId);
      }
      
      allow get: if canReadCompany();
      
      // list queries (incl. `__name__ in`) are used by management dashboards and
      // company/executive/TL contexts only. Employees load their own company via
      // a single document get (see CompanyContext) and cannot enumerate others.
      allow list: if isSuperAdmin() || isCompanyAdmin() ||
        (isExecutive() && isFullScopeForModule('companies')) ||
        (isTeamLeader() && isFullScopeForModule('companies')) ||
        isAuthenticated();
      
      // Team Leaders & Executives: full CRUD over companies (app scopes the
      // visible portfolio); writes are gated by the permission matrix.
      allow create: if isSuperAdmin() ||
        (isTeamLeader() && hasPermission('companies.create')) ||
        (isExecutive() && hasPermission('companies.create'));
      
      allow update: if isSuperAdmin() ||
        (isTeamLeader() && hasPermission('companies.edit')) ||
        (isExecutiveForCompany(companyId) && hasPermission('companies.edit')) ||
        (canManageCompany(companyId) &&
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'domain', 'code', 'adminId', 'adminName', 'adminEmail', 'adminAvatar',
                      'employees', 'status', 'logoColor', 'operationalMode',
                      'assignedExecutiveId', 'assignedExecutiveName',
                      'address', 'phone', 'website', 'description', 'updatedAt',
                      'attendanceSettings', 'payrollSettings',
                      'averageSalary', 'mandatoryAttendanceDays', 'settings',
                      'leaveAllowances'])));
      
      allow delete: if isSuperAdmin() ||
        (isTeamLeader() && hasPermission('companies.delete')) ||
        (isExecutive() && hasPermission('companies.delete'));
    }

    // ============================================
    // DASHBOARD STATS COLLECTION
    // ============================================
    match /dashboardStats/{statId} {
      allow read: if isAuthenticated() &&
        (isSuperAdmin() ||
         belongsToCompany(resource.data.companyId));
      
      allow create: if isSuperAdmin() ||
        (belongsToCompany(request.resource.data.companyId) && hasPermission('dashboard.manage'));
      
      allow update: if isSuperAdmin() ||
        (belongsToCompany(resource.data.companyId) && hasPermission('dashboard.manage'));
      
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow get: if isSuperAdmin() || 
        request.auth.uid == userId ||
        // Team Leaders read their linked/reporting executives' user docs (TL dashboard)
        (isTeamLeader() && isTeamLeaderLinkedTo(userId)) ||
        (isTeamLeader() && isFullScopeForModule('employees')) ||
        // Executives manage Team Leaders whose docs may have a null companyId
        (isExecutive() && resource.data.role == 'team-leader') ||
        (belongsToCompany(resource.data.companyId) && 
         hasPermission('employees.view')) ||
        (canScopeRecord(resource.data.companyId, 'employees') &&
         hasPermission('employees.view'));
      
      allow list: if isAuthenticated();
      
      allow create: if request.auth.uid == userId ||
        (isAuthenticated() && 
         belongsToCompany(request.resource.data.companyId) &&
         hasPermission('user_invite')) ||
        ((isExecutiveForCompany(request.resource.data.companyId) || isTeamLeader()) &&
         hasPermission('employees.create')) ||
        // Team Leader: create Executive accounts (core CRUD)
        (isTeamLeader() &&
         request.resource.data.role == 'executive' &&
         hasPermission('executives.create'));
      
      allow update: if isSuperAdmin() ||
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'avatar', 'email', 'lastLoginAt', 'lastLoginIp', 'updatedAt',
                      'pushToken', 'notificationsEnabled',
                      'designation', 'departmentId', 'department', 'address',
                      'emergencyContactName', 'emergencyContactPhone',
                      'requirePasswordChange'])) ||
        (belongsToCompany(resource.data.companyId) &&
          hasPermission('employees.edit') &&
          resource.data.role != 'company_admin') ||
        // Executives / Team Leaders: full user management in scoped companies.
        // TLs manage their whole portfolio; executives stay company-scoped.
        ((isExecutiveForCompany(resource.data.companyId) || isTeamLeader()) &&
          hasPermission('employees.edit') &&
          resource.data.role != 'company_admin' && resource.data.role != 'master-admin' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])) ||
        // Executives can always manage their linked Team Leaders (null-companyId docs)
        (isExecutive() && resource.data.role == 'team-leader') ||
        // Team Leader: edit Executive accounts within their portfolio (core CRUD)
        (isTeamLeader() &&
         resource.data.role == 'executive' &&
         userId != request.auth.uid &&
         hasPermission('executives.edit') &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'permissions', 'permissionScopes', 'permissionsConfigured', 'companyId'])) ||
        // Transfer Management: master-admin reassigning executives/TLs
        (isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['assignedCompanyIds', 'assignedTeamLeaderIds',
                      'reportingExecutiveId', 'reportingExecutiveName',
                      'linkedExecutiveIds', 'updatedAt']));
      
      allow delete: if isSuperAdmin() ||
        ((isExecutiveForCompany(resource.data.companyId) || isTeamLeader()) &&
         hasPermission('employees.delete') &&
         resource.data.role != 'company_admin' && resource.data.role != 'master-admin' &&
         userId != request.auth.uid) ||
        // Team Leader: delete Executive accounts within their portfolio (core CRUD)
        (isTeamLeader() &&
         resource.data.role == 'executive' &&
         userId != request.auth.uid &&
         hasPermission('executives.delete')) ||
        (isCompanyAdmin() && 
         belongsToCompany(resource.data.companyId) &&
         userId != request.auth.uid);
    }
    
    // ============================================
    // DEPARTMENTS COLLECTION
    // ============================================
    match /departments/{departmentId} {
      allow get: if isSuperAdmin() ||
        belongsToCompany(resource.data.companyId) ||
        canScopeRecord(resource.data.companyId, 'departments');
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('departments'));
      
      allow create: if isSuperAdmin() ||
        canCrudScoped(request.resource.data.companyId, 'departments.create') ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('departments.add')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('departments.add'));
      
      allow update: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'departments.edit') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('departments.edit')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('departments.edit'));
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'departments.delete') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('departments.delete')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('departments.delete'));
    }
    
    // ============================================
    // INVITATIONS COLLECTION
    // ============================================
    match /invitations/{inviteId} {
      allow get: if isSuperAdmin() ||
        resource.data.invitedBy == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('user_invite')) ||
        (resource.data.status == 'pending' &&
         request.query.limit == 1);
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null && hasPermission('user_invite')) ||
        (isExecutive() && hasPermission('user_invite'));
      
      allow create: if isSuperAdmin() ||
        ((isExecutiveForCompany(request.resource.data.companyId) || isTeamLeaderForCompany(request.resource.data.companyId)) &&
         hasPermission('employees.create') &&
         request.resource.data.invitedBy == request.auth.uid) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('user_invite') &&
         request.resource.data.invitedBy == request.auth.uid);
      
      allow update: if false;
      
      allow delete: if isSuperAdmin() ||
        (resource.data.invitedBy == request.auth.uid &&
         resource.data.status == 'pending');
    }
    
    // ============================================
    // AUDIT LOGS COLLECTION
    // ============================================
    // Audit entries can only be written for the caller's OWN userId (prevents
    // forging another user's actions). Reading is restricted to management
    // roles; regular employees cannot enumerate the audit trail.
    match /audit_logs/{logId} {
      allow get: if isAuthenticated() &&
        (isSuperAdmin() || isCompanyAdmin() || isExecutive() || isTeamLeader() ||
         resource.data.userId == request.auth.uid);
      
      allow list: if isSuperAdmin() || isCompanyAdmin() || isExecutive() || isTeamLeader();
      
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      
      allow update, delete: if isSuperAdmin();
    }
    
    // ============================================
    // EMPLOYEE DATA COLLECTIONS
    // ============================================
    
    // Attendance Records
    // Users can create/update their OWN records (check-in/check-out/rectify).
    // Managers (company admin / assigned executive / team-leader / master-admin)
    // can create, update, approve and delete company records.
    match /attendance/{recordId} {
      allow get: if isAuthenticated() &&
        (isSuperAdmin() ||
         resource.data.userId == request.auth.uid ||
         canScopeRecord(resource.data.companyId, 'attendance') ||
         canReviewMissedPunchRecord(resource.data.companyId, resource.data) ||
         (isReportingManager() && belongsToCompany(resource.data.companyId)) ||
         (belongsToCompany(resource.data.companyId) &&
          hasPermission('attendance.view')));

      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('attendance')) ||
        (isTeamLeader() && isFullScopeForModule('attendance'));
      
      // Self check-in must create the user's own record in their own company.
      allow create: if canManageAttendance(request.resource.data.companyId) ||
        (isAuthenticated() &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.companyId == getUserCompanyId());

      // Self check-out / punch rectification on the user's own record; managers
      // can update status, approve and resolve rectifications. Assigned
      // missed-punch tier approvers may advance a request routed to them inside
      // their company scope (mirrors leaveRequests tier-routing) so executives
      // can approve even when their saved matrix omits attendance.manage.
      allow update: if canManageAttendance(resource.data.companyId) ||
        canReviewMissedPunchRecord(resource.data.companyId, resource.data) ||
        (request.auth.uid == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['checkOut', 'workHours', 'overtimeHours', 'isAutoApproved',
                      'approved', 'approvedOn', 'approvedByName',
                      'missedPunchRectification']));
      
      allow delete: if canManageAttendance(resource.data.companyId);
    }
    
    // ============================================
    // ADMIN ALERTS COLLECTION
    // ============================================
    // Created by admin/management users when taking sensitive actions; only
    // management roles (master-admin, company-admin, executive, team-leader)
    // can read them; only master-admin can mutate other users' alerts.
    match /adminAlerts/{alertId} {
      // master-admin sees all alerts; company-admin / executive / team-leader /
      // reporting-manager see only alerts belonging to a company they are
      // scoped to (prevents cross-company leaks and grants the RM tier read
      // access it was previously missing).
      function canReadAlert() {
        return isSuperAdmin() ||
          (resource.data.companyId != null && resource.data.companyId != '' &&
           (belongsToCompany(resource.data.companyId) ||
            isExecutiveForCompany(resource.data.companyId) ||
            isTeamLeaderScopedForCompany(resource.data.companyId)));
      }

      allow get: if isAuthenticated() &&
        (isSuperAdmin() || isCompanyAdmin() || isExecutive() || isTeamLeader() || isReportingManager()) &&
        (isSuperAdmin() || canReadAlert());

      allow list: if isAuthenticated() &&
        (isCompanyAdmin() || isExecutive() || isTeamLeader() || isReportingManager() || isSuperAdmin());

      allow create: if isAuthenticated() &&
        (isSuperAdmin() || isCompanyAdmin() || isExecutive() || isTeamLeader() || isReportingManager()) &&
        (isSuperAdmin() ||
         (request.resource.data.companyId != null && request.resource.data.companyId != '' &&
          (belongsToCompany(request.resource.data.companyId) ||
           isExecutiveForCompany(request.resource.data.companyId) ||
           isTeamLeaderScopedForCompany(request.resource.data.companyId))));

      allow update, delete: if isSuperAdmin();
    }
    
    // Salary/Payroll Records
    match /salary_slips/{slipId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('payroll.view'));
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null);
      
      allow create: if isSuperAdmin() ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('payroll.manage'));
      allow update, delete: if isSuperAdmin() ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('payroll.manage'));
    }
    
    // Leave Requests (snake_case)
    match /leave_requests/{requestId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('leave.view')) ||
        (canScopeRecord(resource.data.companyId, 'leave') && hasPermission('leave.view'));
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('leave'));
allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && 
hasPermission('leave.approve')) ||
        // Employee applying for their own leave (userId === self)
        (isAuthenticated() && request.resource.data.userId == request.auth.uid &&
         request.resource.data.companyId != null && request.resource.data.companyId != '') ||
        // Reporting Manager / management role creating leave for a team member
        (isAuthenticated() && request.resource.data.userId != request.auth.uid &&
         belongsToCompany(request.resource.data.companyId) &&
         (hasPermission('leave.approve') || hasPermission('leave.manage') ||
          hasPermission('leave.create') || isReportingManager()));
      
      allow update: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('leave.approve')) ||
        (belongsToCompany(resource.data.companyId) &&
         (resource.data.userId == request.auth.uid ||
          hasPermission('leave.approve')));
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'leave.delete') ||
        resource.data.userId == request.auth.uid;
    }
    
    // Tasks
    match /tasks/{taskId} {
      allow get: if isSuperAdmin() ||
        resource.data.assignedToId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (canScopeRecord(resource.data.companyId, 'tasks') && hasPermission('tasks.view'));
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('tasks'));
      
      allow create: if isSuperAdmin() ||
        canCrudScoped(request.resource.data.companyId, 'tasks.create') ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('tasks.manage')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('tasks.create'));
      
      allow update: if isSuperAdmin() ||
        resource.data.assignedToId == request.auth.uid ||
        canCrudScoped(resource.data.companyId, 'tasks.edit') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('tasks.manage')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('tasks.edit'));
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'tasks.delete') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('tasks.manage')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('tasks.delete'));
    }
    
    // Holidays
    match /holidays/{holidayId} {
      allow get: if isSuperAdmin() ||
        resource.data.companyId == null ||
        belongsToCompany(resource.data.companyId) ||
        canScopeRecord(resource.data.companyId, 'holidays');
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('holidays'));
      
      allow create: if isSuperAdmin() ||
        canCrudScoped(request.resource.data.companyId, 'holidays.create') ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('holidays.manage')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('holidays.create'));
      allow update: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'holidays.edit') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('holidays.manage')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('holidays.edit'));
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'holidays.delete') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('holidays.manage')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('holidays.delete'));
    }
    
    // Support Tickets
    match /tickets/{ticketId} {
      allow get: if isSuperAdmin() ||
        resource.data.createdById == request.auth.uid ||
        (canScopeRecord(resource.data.companyId, 'support') && hasPermission('employees.view')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.view'));
      
      allow list: if isSuperAdmin() ||
        (isCompanyAdmin() && getUserCompanyId() != null) ||
        (isAuthenticated() && getUserCompanyId() != null && hasPermission('employees.view')) ||
        (isExecutive() && isFullScopeForModule('support') && hasPermission('employees.view')) ||
        (isTeamLeader() && isFullScopeForModule('support') && hasPermission('employees.view'));
      
      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId)) ||
        belongsToCompany(request.resource.data.companyId);
      
      allow update: if isSuperAdmin() ||
        resource.data.createdById == request.auth.uid ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('employees.edit')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.edit'));
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'support.delete');
    }
    
    // ============================================
    // MESSAGING COLLECTIONS
    // ============================================
    
    // Conversations
    match /conversations/{conversationId} {
      allow get: if isSuperAdmin() ||
        request.auth.uid in resource.data.participants;
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive()) ||
        (isTeamLeader());
      
      allow create: if isSuperAdmin() ||
        (isAuthenticated() &&
         request.auth.uid in request.resource.data.participants &&
         (belongsToCompany(request.resource.data.companyId) ||
          isExecutiveForCompany(request.resource.data.companyId)));
      
      allow update: if isSuperAdmin() ||
        request.auth.uid in resource.data.participants;
      
      allow delete: if isSuperAdmin();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSuperAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        allow create: if isSuperAdmin() ||
          (isAuthenticated() &&
           request.auth.uid == request.resource.data.senderId &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        
        allow update: if isSuperAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        allow delete: if isSuperAdmin();
      }
    }
    
    // ============================================
    // EMPLOYEES COLLECTION
    // ============================================
    match /employees/{employeeId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) &&
         (isCompanyAdmin() || hasPermission('employees.view'))) ||
        (canScopeRecord(resource.data.companyId, 'employees') && hasPermission('employees.view'));
      
      allow list: if isAuthenticated();
      
      allow create: if isSuperAdmin() ||
        canCrudScoped(request.resource.data.companyId, 'employees.create') ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('employees.create')) ||
        (belongsToCompany(request.resource.data.companyId) &&
          hasPermission('employees.create'));
      
      allow update: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'employees.edit') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('employees.edit')) ||
        (belongsToCompany(resource.data.companyId) &&
          hasPermission('employees.edit'));
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'employees.delete') ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('employees.delete')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.delete'));
      
      // --- Subcollections ---
      
      function empBelongsToCompany() {
        return get(/databases/$(database)/documents/employees/$(employeeId)).data.companyId;
      }
      
      // Bank Accounts
      match /bankAccounts/{bankAccountId} {
        allow read: if isSuperAdmin() ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.view'));
        
        allow create: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'employees.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
        
        allow update: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'employees.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
        
        allow delete: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'employees.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
      }
      
      // Documents
      match /documents/{documentId} {
        allow read: if isSuperAdmin() ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.view'));
        
        allow create: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'documents.create') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
        
        allow update, delete: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'documents.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
      }
      
      // Contracts
      match /contracts/{contractId} {
        allow read: if isSuperAdmin() ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.view'));
        
        allow create: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'employees.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
        
        allow update: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'employees.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
        
        allow delete: if isSuperAdmin() ||
          canCrudScoped(empBelongsToCompany(), 'employees.edit') ||
          (belongsToCompany(empBelongsToCompany()) &&
           hasPermission('employees.edit'));
      }
    }

    // ============================================
    // ANNOUNCEMENTS COLLECTION
    // ============================================
    match /announcements/{announcementId} {
      allow get: if isSuperAdmin() ||
        belongsToCompany(resource.data.companyId) ||
        canScopeRecord(resource.data.companyId, 'announcements');
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('announcements'));

      allow create: if isSuperAdmin() ||
        canCrudScoped(request.resource.data.companyId, 'announcements.create') ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('announcements.create')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('announcements.create'));
      
      allow update: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('announcements.edit')) ||
        (belongsToCompany(resource.data.companyId) &&
         (isCompanyAdmin() || hasPermission('announcements.edit')));
      
      allow delete: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('announcements.delete')) ||
        (belongsToCompany(resource.data.companyId) &&
         (isCompanyAdmin() || hasPermission('announcements.delete')));
    }

    // ============================================
    // ASSETS COLLECTION
    // ============================================
    match /assets/{assetId} {
      allow get: if isSuperAdmin() ||
        belongsToCompany(resource.data.companyId);
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('assets'));

      allow create: if isSuperAdmin() ||
        canCrudScoped(request.resource.data.companyId, 'asset_create') ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('asset_create')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('asset_create'));
      
      allow update: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'asset_edit') ||
        belongsToCompany(resource.data.companyId);
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'asset_delete') ||
        belongsToCompany(resource.data.companyId);
    }

    // ============================================
    // LEAVE REQUESTS COLLECTION (camelCase)
    // ============================================
    match /leaveRequests/{requestId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.approverIds.reportingManager == request.auth.uid ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (canScopeRecord(resource.data.companyId, 'leave') && hasPermission('leave.view'));
      
      allow list: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.approverIds.reportingManager == request.auth.uid ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('leave'));

      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('leave.approve')) ||
        // Employee applying for their own leave (userId === self) — no company
        // match required so an employee whose users doc lacks companyId can
        // still apply; the leave is scoped to the employee's actual company.
        (isAuthenticated() && request.resource.data.userId == request.auth.uid &&
         request.resource.data.companyId != null && request.resource.data.companyId != '') ||
        // Reporting Manager / management role creating a leave for a team
        // member inside their own company. Reporting-manager permission arrays
        // may omit leave.approve, so also accept leave.manage / leave.create
        // (or the RM role itself).
        (isAuthenticated() && request.resource.data.userId != request.auth.uid &&
         belongsToCompany(request.resource.data.companyId) &&
         (hasPermission('leave.approve') || hasPermission('leave.manage') ||
          hasPermission('leave.create') || isReportingManager()));
      
      allow update: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('leave.approve')) ||
        (belongsToCompany(resource.data.companyId) &&
         (resource.data.userId == request.auth.uid ||
          hasPermission('leave.approve'))) ||
        // Reporting Manager approving/rejecting requests routed to them
        (isReportingManager() &&
         belongsToCompany(resource.data.companyId) &&
         resource.data.approverIds.reportingManager == request.auth.uid) ||
        // Company Admin (Tier 2) approving/rejecting requests routed to them
        (isCompanyAdmin() &&
         belongsToCompany(resource.data.companyId) &&
         resource.data.approverIds.companyAdmin == request.auth.uid) ||
        // Executive (Tier 3) approving/rejecting requests routed to them
        (isExecutiveForCompany(resource.data.companyId) &&
         resource.data.approverIds.executive == request.auth.uid) ||
        // Team Leader (Tier 4) approving/rejecting requests routed to them
        // (scoped to the company, either by direct membership or via their
        // linked / portfolio executive so cross-company approval works)
        (isTeamLeaderScopedForCompany(resource.data.companyId) &&
         resource.data.approverIds.teamLeader == request.auth.uid);
      
      allow delete: if isSuperAdmin() ||
        canCrudScoped(resource.data.companyId, 'leave.delete') ||
        resource.data.userId == request.auth.uid;
    }

    // ============================================
    // SALARY SLIPS COLLECTION (camelCase)
    // ============================================
    // Company-admin: view-only. Executive/TL: full manage. Employee: self-read.
    match /salarySlips/{slipId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        canScopeRecord(resource.data.companyId, 'payroll');
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null) ||
        (isExecutive() && isFullScopeForModule('payroll')) ||
        (isTeamLeader() && isFullScopeForModule('payroll'));

      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('payroll.manage')) ||
        (isTeamLeaderForCompany(request.resource.data.companyId) && hasPermission('payroll.manage'));
      // Company Admin may run salary-slip corrections (edit corrected figures)
      // scoped to their own company. Executive/TL keep full payroll manage.
      allow update: if isSuperAdmin() ||
        (isCompanyAdmin() && belongsToCompany(resource.data.companyId)) ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('payroll.manage')) ||
        (isTeamLeaderForCompany(resource.data.companyId) && hasPermission('payroll.manage'));
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // ============================================
    // PAYROLL RUNS COLLECTION
    // ============================================
    // Company-admin: view-only. Executive/TL: full manage.
    match /payrollRuns/{runId} {
      allow get: if isSuperAdmin() ||
        canScopeRecord(resource.data.companyId, 'payroll');
      allow list: if isSuperAdmin() ||
        (isExecutive() && isFullScopeForModule('payroll')) ||
        (isTeamLeader() && isFullScopeForModule('payroll')) ||
        (isAuthenticated() && getUserCompanyId() != null);

      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('payroll.manage')) ||
        (isTeamLeaderForCompany(request.resource.data.companyId) && hasPermission('payroll.manage'));
      
      allow update: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('payroll.manage')) ||
        (isTeamLeaderForCompany(resource.data.companyId) && hasPermission('payroll.manage'));
      
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // PAYROLL AUDIT COLLECTION
    // ============================================
    match /payrollAudit/{auditId} {
      allow get: if isSuperAdmin() ||
        canScopeRecord(resource.data.companyId, 'payroll');
      allow list: if isSuperAdmin() ||
        (isExecutive() && isFullScopeForModule('payroll')) ||
        (isTeamLeader() && isFullScopeForModule('payroll')) ||
        (isAuthenticated() && getUserCompanyId() != null);
      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('payroll.manage')) ||
        (isTeamLeaderForCompany(request.resource.data.companyId) && hasPermission('payroll.manage'));
      allow update, delete: if isSuperAdmin();
    }

    // ============================================
    // SALARY STRUCTURES COLLECTION
    // ============================================
    match /salaryStructures/{structureId} {
      allow get: if isSuperAdmin() ||
        canScopeRecord(resource.data.companyId, 'salary');
      
      allow list: if isSuperAdmin() ||
        (isExecutive() && isFullScopeForModule('salary')) ||
        (isTeamLeader() && isFullScopeForModule('salary')) ||
        (isAuthenticated() && getUserCompanyId() != null);
      
      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('salary.manage')) ||
        (isTeamLeaderForCompany(request.resource.data.companyId) && hasPermission('salary.manage'));
      
      allow update: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('salary.manage')) ||
        (isTeamLeaderForCompany(resource.data.companyId) && hasPermission('salary.manage'));
      
      allow delete: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('salary.manage')) ||
        (isTeamLeaderForCompany(resource.data.companyId) && hasPermission('salary.manage'));
    }

    // ============================================
    // EMAILS COLLECTION
    // ============================================
    match /emails/{emailId} {
      // App grants dotted-plural strings ('emails.view'); older docs may have
      // snake-singular ('email_view'). Accept both via hasPermission().
      function canViewEmails() {
        return hasPermission('emails.view') || hasPermission('email_view');
      }
      function canCreateEmails() {
        return hasPermission('emails.create') || hasPermission('email_create');
      }
      function canEditEmails() {
        return hasPermission('emails.edit') || hasPermission('email_edit');
      }
      function canDeleteEmails() {
        return hasPermission('emails.delete') || hasPermission('email_delete');
      }

      allow get: if isSuperAdmin() ||
        (isCompanyAdmin() && getUserCompanyId() != null) ||
        (isTeamLeader() && isFullScopeForModule('emails')) ||
        (canScopeRecord(resource.data.companyId, 'emails') && canViewEmails()) ||
        (belongsToCompany(resource.data.companyId) && canViewEmails());

      allow list: if isSuperAdmin() ||
        isCompanyAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null && canViewEmails()) ||
        (isExecutive() && isFullScopeForModule('emails')) ||
        (isTeamLeader() && isFullScopeForModule('emails'));

      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && canCreateEmails()) ||
        (belongsToCompany(request.resource.data.companyId) && canCreateEmails());

      allow update: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && canEditEmails()) ||
        (belongsToCompany(resource.data.companyId) && canEditEmails());

      allow delete: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && canDeleteEmails()) ||
        (belongsToCompany(resource.data.companyId) && canDeleteEmails());
    }

    // ============================================
    // PERFORMANCE REVIEWS COLLECTION
    // ============================================
    match /performanceReviews/{reviewId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.view'));
      
      allow list: if isSuperAdmin() ||
        request.auth.uid == resource.data.userId ||
        (isAuthenticated() && getUserCompanyId() != null && hasPermission('employees.view')) ||
        (isExecutive() && isFullScopeForModule('employees') && hasPermission('employees.view')) ||
        (isTeamLeader() && isFullScopeForModule('employees') && hasPermission('employees.view'));

      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('employees.edit')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('employees.edit'));
      
      allow update, delete: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('employees.edit')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.edit'));
    }

    // ============================================
    // ROLES COLLECTION
    // ============================================
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() ||
        (isCompanyAdmin() && belongsToCompany(request.resource.data.companyId));
      allow update: if isSuperAdmin() ||
        (isCompanyAdmin() && belongsToCompany(resource.data.companyId));
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // DOCUMENTS COLLECTION
    // ============================================
    match /documents/{documentId} {
      allow get: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.view'));
      
      allow list: if isSuperAdmin() ||
        request.auth.uid == resource.data.userId ||
        (isAuthenticated() && getUserCompanyId() != null && hasPermission('employees.view')) ||
        (isExecutive() && isFullScopeForModule('documents') && hasPermission('employees.view'));

      allow create: if isSuperAdmin() ||
        (isExecutiveForCompany(request.resource.data.companyId) && hasPermission('employees.edit')) ||
        (belongsToCompany(request.resource.data.companyId) &&
         hasPermission('employees.edit'));
      
      allow update, delete: if isSuperAdmin() ||
        (isExecutiveForCompany(resource.data.companyId) && hasPermission('employees.edit')) ||
        (belongsToCompany(resource.data.companyId) &&
         hasPermission('employees.edit'));
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      allow get: if isSuperAdmin() ||
        request.auth.uid == resource.data.userId;
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.userId != null &&
        request.resource.data.userId != '';
      
      allow update: if isSuperAdmin() ||
        request.auth.uid == resource.data.userId;
      
      allow delete: if isSuperAdmin() ||
        request.auth.uid == resource.data.userId;
    }
    
    // ============================================
    // TRANSFERS COLLECTION
    // ============================================
    match /transfers/{transferId} {
      // Read: Master Admin or the source/dest executive
      allow get: if isSuperAdmin() ||
        (isExecutive() && (
          resource.data.sourceExecutiveId == request.auth.uid ||
          resource.data.destExecutiveId == request.auth.uid
        ));
      
      allow list: if isSuperAdmin() ||
        (isExecutive() && isFullScopeForModule('executives'));
      
      // Create: Master Admin only (transfers are admin-initiated)
      // Validation: initiator_id must match auth.uid, company must be Continuous
      allow create: if isSuperAdmin() &&
        request.resource.data.initiatorId == request.auth.uid &&
        request.resource.data.status == 'completed' &&
        request.resource.data.keys().hasAll([
          'sourceExecutiveId', 'sourceExecutiveName',
          'destExecutiveId', 'destExecutiveName',
          'transferredCompanies', 'transferredTeamLeaders',
          'initiatorId', 'initiatorName', 'status', 'createdAt'
        ]);
      
      allow update: if isSuperAdmin();
      
      allow delete: if false; // Transfers are immutable records
    }

    // ============================================
    // SUPPORT_TICKETS COLLECTION
    // ============================================
    match /support_tickets/{ticketId} {
      // Any authenticated user can create a ticket
      allow create: if isAuthenticated() &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.keys().hasAll(['title', 'description', 'category', 'createdBy', 'createdById', 'createdAt']);
      
      // Users can read their own tickets; master-admins and company-admins can read all
      allow read: if isAuthenticated() && (
        resource.data.createdById == request.auth.uid ||
        isSuperAdmin() ||
        (isCompanyAdmin() && resource.data.companyId == getUserCompanyId())
      );
      
      // Users can update their own open tickets; admins can update any
      allow update: if isAuthenticated() && (
        (resource.data.createdById == request.auth.uid && resource.data.status == 'Open') ||
        isSuperAdmin() ||
        (isCompanyAdmin() && resource.data.companyId == getUserCompanyId())
      );
      
      // Only admins can delete
      allow delete: if isSuperAdmin() ||
        (isCompanyAdmin() && resource.data.companyId == getUserCompanyId());
    }

    // ============================================
    // SHIFT CONFIGS COLLECTION
    // ============================================
    match /shiftConfigs/{shiftId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() ||
        (belongsToCompany(request.resource.data.companyId) && hasPermission('attendance.manage'));
      allow update, delete: if isSuperAdmin() ||
        (belongsToCompany(resource.data.companyId) && hasPermission('attendance.manage'));
    }

    // ============================================
    // COMPANY SETTINGS COLLECTION
    // ============================================
    match /companySettings/{settingId} {
      allow read: if isSuperAdmin() ||
        belongsToCompany(resource.data.companyId);
      allow create: if isSuperAdmin() ||
        (belongsToCompany(request.resource.data.companyId) && hasPermission('settings.edit'));
      allow update, delete: if isSuperAdmin() ||
        (belongsToCompany(resource.data.companyId) && hasPermission('settings.edit'));
    }

    // ============================================
    // ATTENDANCE SETTINGS COLLECTION
    // ============================================
    // Employees read their own company's policy (used by check-in gating); only
    // members/management of that company and master-admins can read settings.
    match /attendanceSettings/{settingId} {
      allow get: if isSuperAdmin() ||
        canScopeRecord(resource.data.companyId, 'attendance');
      
      allow list: if isSuperAdmin() ||
        (isAuthenticated() && getUserCompanyId() != null);
      
      allow create: if isSuperAdmin() ||
        isTeamLeader() ||
        isExecutive() ||
        (belongsToCompany(request.resource.data.companyId) && hasPermission('attendance.manage'));
      allow update: if isSuperAdmin() ||
        isTeamLeader() ||
        isExecutive() ||
        (belongsToCompany(resource.data.companyId) && hasPermission('attendance.manage'));
      allow delete: if isSuperAdmin();
    }

    // ============================================
    // ATTENDANCE LOGS COLLECTION
    // ============================================
    match /attendanceLogs/{logId} {
      allow read: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (belongsToCompany(resource.data.companyId) && hasPermission('attendance.view'));
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
