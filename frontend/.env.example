# ============================================================
# HR MAX — AWS configuration (frontend)
# Values come from `aws cloudformation describe-stacks` after deploy,
# or from the SAM deploy outputs.
# ============================================================

# AWS region where the stack was deployed
VITE_AWS_REGION=ap-southeast-2

# Cognito User Pool (Outputs: UserPoolId)
VITE_COGNITO_USER_POOL_ID=

# Cognito App Client (Outputs: UserPoolClientId)
VITE_COGNITO_CLIENT_ID=

# API Gateway base URL (Outputs: ApiUrl) — no trailing slash
VITE_API_URL=

# S3 files bucket website / CloudFront URL for direct file access (Outputs: CloudFrontUrl)
VITE_FILES_BUCKET_URL=
